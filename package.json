{
  "name": "pwtk-web-template-tk01-t_tk002",
  "type": "module",
  "version": "1.1.0",
  "scripts": {
    "clean": "rm -rf certs",
    "setup-https": "bash scripts/setup-https.sh",
    "version:create": "node scripts/create-version-file.js",
    "version:update": "node scripts/update-version.js",
    "version:show": "node -e \"import('fs').then(fs => console.log(JSON.parse(fs.readFileSync('./package.json')).version))\"",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:bump": "npm run version:patch && npm run version:create",
    "version:auto": "node scripts/bump-version.js && npm run version:create",
    "predev": "npm run clean",
    "dev": "npm run version:create && DARK_MODE=true astro dev",
    "predev:light": "npm run clean",
    "dev:light": "npm run version:create && astro dev",
    "predev:https": "npm run setup-https",
    "dev:https": "npm run version:create && DARK_MODE=true astro dev",
    "start": "npm run dev",
    "start:light": "npm run dev:light",
    "start:https": "npm run dev:https",
    "prebuild": "npm run clean",
    "build": "DARK_MODE=true astro check && astro build && npm run version:update",
    "prebuild:light": "npm run clean",
    "build:light": "astro check && astro build && npm run version:update",
    "prepreview": "npm run clean",
    "preview": "astro preview",
    "deploy": "npm run build && npm run version:show",
    "deploy:light": "npm run build:light && npm run version:show",
    "astro": "astro",
    "test:coverage": "vitest run --coverage",
    "test:unused-components": "node scripts/find-unused-components.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.3",
    "@astrojs/node": "^8.3.4",
    "@astrojs/vue": "^4.5.1",
    "@chenfengyuan/vue-qrcode": "^2.0.0",
    "@vant/touch-emulator": "^1.4.0",
    "@vant/use": "^1.6.0",
    "@videojs/themes": "^1.0.1",
    "astro": "^4.15.9",
    "axios": "^1.7.7",
    "canvas-confetti": "^1.9.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "js-sha1": "^0.7.0",
    "json-bigint": "^1.0.0",
    "lodash": "^4.17.21",
    "pinyin": "4.0.0-alpha.2",
    "qrcode": "1",
    "segmentit": "^2.0.3",
    "shaka-player": "^4.12.5",
    "tone": "^15.0.4",
    "typescript": "^5.6.2",
    "vant": "^4.9.7",
    "vconsole": "^3.15.1",
    "video.js": "^8.21.0",
    "vue": "^3.5.8",
    "vue3-emoji-picker": "^1.1.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^22.7.4",
    "@types/pinyin": "^2.10.2",
    "@types/video.js": "^7.3.58",
    "@types/vue-router": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "glob": "^10.3.10",
    "jsdom": "^24.1.3",
    "less": "^4.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "sass-embedded": "^1.89.0"
  }
}
